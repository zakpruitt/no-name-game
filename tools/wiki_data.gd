extends SceneTree
## Exports the tables the wiki (docs/wiki/index.html) reads into docs/wiki/data.js: the kit card
## (scripts/kit_slots.gd), the moves (scripts/move_list.gd + hero_moves COMBOS), the breakers
## (void_element.BREAKERS with ComicFx's words), the six state rules and the upgrade cells (void_element, kit.gd),
## the counter (counter.gd) and the swinging dummy (training_dummy.gd).
##   godot --headless --path . -s tools/wiki_data.gd           write docs/wiki/data.js
##   python tools/wiki.py                                      the same, plus a check of docs/wiki/notes.js
## tests/wiki_check.gd calls build() and fails when data.js differs (a move or breaker changed, wiki not rebuilt).
## No commit hash or date goes in: the file only changes when the code it reads does.

const OUT := "res://docs/wiki/data.js"
const HEAD := "// Generated by tools/wiki_data.gd from the game's tables. Do not edit: run `python tools/wiki.py`.\nwindow.WIKI = "


func _initialize() -> void:
	await process_frame
	var text := build()
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(text)
	f.close()
	print("[wiki] wrote %s (%d bytes)" % [OUT, text.length()])
	quit(0)


## The whole data.js text. Static so tests/wiki_check.gd can build it and compare.
static func build() -> String:
	return HEAD + JSON.stringify(_data(), " ", true) + ";\n"


static func _data() -> Dictionary:
	var moves_s: GDScript = load("res://scripts/hero_moves.gd")
	var void_s: GDScript = load("res://scripts/void_element.gd")
	var list_s: GDScript = load("res://scripts/move_list.gd")
	var fx_s: GDScript = load("res://scripts/comic_fx.gd")
	var counter_s: GDScript = load("res://scripts/counter.gd")
	var dummy_s: GDScript = load("res://scripts/training_dummy.gd")
	var awaken_s: GDScript = load("res://scripts/hero_awaken.gd")
	var game: GDScript = load("res://scripts/game.gd")

	var elements: Dictionary = void_s.ELEMENT_OF.duplicate()
	elements.merge(moves_s.WEAPON_ELEMENT)

	var names := {}
	for id: String in moves_s.COMBOS:
		names[id] = {"name": moves_s.COMBOS[id].name, "input": moves_s.COMBOS[id].input, "tier": moves_s.COMBOS[id].tier}
	for id: String in moves_s.MOVE_NAMES:
		names[id] = {"name": moves_s.MOVE_NAMES[id], "tier": 0}

	var sections := []
	for s: Dictionary in list_s.SECTIONS:
		var h: Array = list_s.heading(s)
		var rows := []
		for r: Dictionary in s.rows:
			var row := {"input": r.input, "kind": r.kind, "note": r.note,
				"name": moves_s.guide_name(r.id) if r.kind == "move" else r.name}
			for k: String in ["id", "or", "tier", "state", "rule", "el", "upgrade"]:
				if r.has(k):
					row[k] = r[k]
			if r.kind == "move":
				row["tag"] = KitSlots.tag_of(r.id)
			rows.append(row)
		sections.append({"group": s.get("group", 0), "title": h[0], "hint": h[1], "rows": rows})

	var window: Dictionary = void_s._WINDOW
	var breakers := {}
	for key: String in void_s.BREAKERS:
		var b: Dictionary = void_s.BREAKERS[key]
		var name: String = b.names.spirit
		var e := {"name": name, "word": fx_s.BREAKER_WORDS.get(name, ""), "erupt": b.erupt, "damage": b.damage,
			"awaken": b.awaken, "awaken_perfect": b.awaken_perfect}
		if b.has("alt"):
			var alt_name: String = b.alt.names.spirit
			e["alt"] = {"name": alt_name, "word": fx_s.BREAKER_WORDS.get(alt_name, ""),
				"erupt": b.alt.get("erupt", b.erupt), "damage": b.alt.get("damage", b.damage)}
		breakers[key] = e

	var upgrade_cells := {}
	for cell: String in void_s.IMPROV_UPGRADE:
		var id: String = void_s.IMPROV_UPGRADE[cell]
		var parts := cell.split("_x_")
		upgrade_cells[cell] = {"id": id, "state": parts[0], "el": parts[1], "doc": Kit.UPGRADES[id],
			"word": fx_s.IMPROV_WORDS.get(cell, "")}

	var rules := {}
	for st: String in void_s.RULES:
		rules[st] = {"rule": void_s.RULES[st], "name": void_s.RULE_NAMES[st], "word": fx_s.IMPROV_WORDS.get(st, ""),
			"own": void_s.RULE_OWN.get(st, ""), "self": void_s.RULE_SELF.get(st, [])}

	return {
		"groups": KitSlots.GROUPS,
		"slots": KitSlots.SLOTS,
		"cards": {"heretic": KitSlots.HERETIC},
		"kit_upgrades": Kit.UPGRADES,
		"names": names,
		"elements": elements,
		"element_words": moves_s.ELEMENT_WORDS,
		"move_words": fx_s.MOVE_WORDS,
		"move_list": sections,
		"breakers": breakers,
		"window": {"perfect_mult": window.perfect_mult, "hang_to_open": void_s.BREAKER_HANG,
			"open_to_sweet": void_s.BREAKER_TO_SWEET, "open_to_close": void_s.BREAKER_TO_CLOSE},
		"rules": rules,
		"rule_numbers": {"shatter_mult": void_s.RULE_SHATTER_MULT, "arc_r": void_s.RULE_ARC_R,
			"burst_r": void_s.RULE_BURST_R, "juggle_launch": void_s.RULE_JUGGLE_LAUNCH, "mult": void_s.IMPROV_MULT,
			"chain_damage": void_s.IMPROV_CHAIN_DAMAGE, "hold": void_s.ELEMENT_HOLD, "charged_hold": void_s.CHARGED_HOLD},
		"upgrade_cells": upgrade_cells,
		"counter": {"window": counter_s.WINDOW, "perfect": counter_s.PERFECT, "arc": counter_s.ARC,
			"reach_pad": counter_s.REACH_PAD, "damage": counter_s.DAMAGE, "stop": counter_s.STOP,
			"perfect_stop": counter_s.PERFECT_STOP, "awaken": counter_s.AWAKEN, "awaken_perfect": counter_s.AWAKEN_PERFECT,
			"ricochet_wall_mult": counter_s.RICOCHET_WALL_MULT, "ricochet_reach": counter_s.RICOCHET_REACH,
			"ricochet_speed": counter_s.RICOCHET_SPEED, "bind_time": counter_s.BIND_TIME},
		"dummy": {"swing_range": dummy_s.SWING_RANGE, "swing_arc": dummy_s.SWING_ARC, "swing_beat": dummy_s.SWING_BEAT,
			"swing_every": dummy_s.SWING_EVERY, "swing_windup": dummy_s.SWING_WINDUP, "swing_damage": dummy_s.SWING_DAMAGE},
		"awakening": {"damage_mult": awaken_s.DAMAGE_MULT, "damage_taken": awaken_s.DAMAGE_TAKEN,
			"speed_mult": awaken_s.SPEED_MULT, "burst_radius": awaken_s.AWAKEN_BURST_RADIUS},
		"ranks": game.RANKS,
	}
