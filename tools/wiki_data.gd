extends SceneTree
## Exports the game's tuning tables (moves, combos, enemies, boss, powers,
## synergies, twists, camp/shrine/altar) to docs/wiki/data.js, which
## docs/wiki/index.html renders. Run via `python tools/wiki.py`, or directly:
## godot --headless --path . -s tools/wiki_data.gd

const OUT := "res://docs/wiki/data.js"


func _initialize() -> void:
	var game: Node = get_root().get_node("Game")
	var player_s: GDScript = load("res://scripts/player.gd")
	var main_s: GDScript = load("res://scripts/main.gd")
	var boss_s: GDScript = load("res://scripts/boss.gd")
	var enemy_s: GDScript = load("res://scripts/enemy.gd")
	var altar_s: GDScript = load("res://scripts/altar.gd")
	var asc_s: GDScript = load("res://scripts/ascendancy.gd")
	var el_s: GDScript = load("res://scripts/elements.gd")

	var p: Node = player_s.new()
	var hero := {}
	for k: String in ["max_hp", "move_speed", "dash_speed", "dash_time", "dash_cooldown", "input_buffer",
			"aim_assist_range", "aim_assist_angle", "awaken_duration", "perfect_dodge_window",
			"perfect_dodge_refund", "perfect_dodge_stun", "level_hp"]:
		hero[k] = p.get(k)
	hero["charge_time"] = player_s.CHARGE_TIME
	hero["charge_move_mult"] = player_s.CHARGE_MOVE_MULT
	hero["guide_learned"] = player_s.GUIDE_LEARNED
	p.free()

	# Each move's time to its cancel point and damage per second, no powers
	# (the same sums as power_check's DPS_LIMIT check).
	var rig: Node = player_s.MODEL.instantiate()
	var anim: AnimationPlayer = rig.find_child("AnimationPlayer", true, false)
	var move_time := {}
	for id: String in player_s.MOVES:
		var m: Dictionary = player_s.MOVES[id]
		if anim != null and anim.has_animation(m.anim):
			var t: float = anim.get_animation(m.anim).length * m.get("cancel", m.get("end", 1.0)) / m.get("speed", 1.0)
			move_time[id] = {"time": snappedf(t, 0.01), "dps": snappedf(m.damage * m.get("hits", [0]).size() / t, 0.1)}
	rig.free()

	var e: Node = enemy_s.new()
	var enemy_defaults := {}
	for k: String in ["max_hp", "move_speed", "attack_range", "attack_damage", "attack_windup", "attack_recover",
			"poise", "model_scale", "attack_kind", "dodge_chance", "bones", "blast_radius", "blast_enemy_damage",
			"raise_count", "raise_cooldown", "preferred_range", "projectile_speed"]:
		enemy_defaults[k] = e.get(k)
	e.free()

	var b: Node = boss_s.new()
	var boss := {"spec": _plain(main_s.BOSS_SPEC), "escort": main_s.BOSS_ESCORT, "attacks": boss_s.ATTACKS}
	for k: String in ["break_damage", "break_window", "break_stun", "enrage_speed", "enrage_summon", "dodge_stun_mult"]:
		boss[k] = b.get(k)
	b.free()

	var enemies := {}
	for id: String in main_s.ENEMY_TYPES:
		enemies[id] = _plain(enemy_defaults.merged(main_s.ENEMY_TYPES[id], true))

	var data := {
		"built": Time.get_datetime_string_from_system(false, true),
		"commit": _git(["rev-parse", "--short", "HEAD"]),
		"branch": _git(["rev-parse", "--abbrev-ref", "HEAD"]),
		"hero": hero,
		"moves": player_s.MOVES,
		"move_time": move_time,
		"combos": player_s.COMBOS,
		"light_chain": player_s.LIGHT_CHAIN,
		"ranks": game.RANKS,
		"air_milestones": game.AIR_MILESTONES,
		"enemies": enemies,
		"boss": boss,
		"powers": Upgrades.ALL,
		"max_level": Upgrades.MAX_LEVEL,
		"synergies": Upgrades.SYNERGIES,
		"synergy_need": Upgrades.SYNERGY_NEED,
		"paths": _colors_to_hex(Upgrades.PATHS),
		"mastery_need": Upgrades.MASTERY_NEED,
		"fusion_chance": Upgrades.FUSION_CHANCE,
		"map": {
			"lanes": RunMap.LANES, "weights": RunMap.WEIGHTS, "kinds": _colors_to_hex(RunMap.KINDS), "trials": RunMap.TRIALS, "mystery": RunMap.MYSTERY,
			"unlock_room": RunMap.UNLOCK_ROOM, "trial_size": main_s.TRIAL_SIZE, "trial_bones": main_s.TRIAL_BONES,
			"powers": RunMap.POWERS, "low_hp": load("res://scripts/map_screen.gd").LOW_HP,
		},
		"twists": main_s.ELITE_TWISTS,
		"run": {
			"length": main_s.RUN_LENGTH, "rest_heal": main_s.REST_HEAL, "room_clear_heal": main_s.ROOM_CLEAR_HEAL,
			"elite_rewards": main_s.ELITE_REWARDS, "reroll_cost": main_s.REROLL_COST,
			"reroll_cost_step": main_s.REROLL_COST_STEP, "split_hp": main_s.SPLIT_HP,
		},
		"camp": main_s.CAMP,
		"shrine": main_s.SHRINE,
		"shrine_rotating": main_s.SHRINE_ROTATING,
		"boons": altar_s.BOONS,
		"levels": {"xp": game.LEVEL_XP, "max": game.LEVEL_MAX},
		"ascendancy": _colors_to_hex(asc_s.PATHS),
		"ascend_base_color": (asc_s.BASE_COLOR as Color).to_html(false),
		"casts": el_s.CASTS,
		"element_colors": _colors_to_hex(el_s.LOOK),
		"ultimates": player_s.ULTIMATES,
		"ult_chain_bonus": player_s.ULT_CHAIN_BONUS,
		"trinity": player_s.TRINITY,
	}
	var f := FileAccess.open(ProjectSettings.globalize_path(OUT), FileAccess.WRITE)
	f.store_string("// Generated by tools/wiki_data.gd; don't edit by hand.\nwindow.WIKI = %s;\n" % JSON.stringify(data, "  ", false))
	f.close()
	print("[wiki] wrote %s (%d moves, %d enemies, %d powers)" % [OUT, data.moves.size(), enemies.size(), Upgrades.ALL.size()])
	quit()


## Copy of `d` (dict of dicts) with Color values as "rrggbb".
func _colors_to_hex(d: Dictionary) -> Dictionary:
	var out := {}
	for k: String in d:
		var row: Dictionary = d[k].duplicate()
		for f: String in row:
			if row[f] is Color:
				row[f] = (row[f] as Color).to_html(false)
		out[k] = row
	return out


## Drops values JSON can't hold cleanly (colors, resources).
func _plain(d: Dictionary) -> Dictionary:
	var out := {}
	for k: String in d:
		if typeof(d[k]) in [TYPE_INT, TYPE_FLOAT, TYPE_STRING, TYPE_BOOL]:
			out[k] = d[k]
	return out


func _git(args: Array) -> String:
	var out := []
	OS.execute("git", PackedStringArray(args), out)
	return (out[0] as String).strip_edges() if out.size() > 0 else ""
