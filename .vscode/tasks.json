{
	// Headless checks (no Godot window). Needs `godot` and Git Bash's `bash` on PATH.
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Checks: all (PASS/FAIL tests + autotest)",
			"type": "process",
			"command": "bash",
			"args": ["tools/agent.sh", "check"],
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "Checks: quick",
			"type": "process",
			"command": "bash",
			"args": ["tools/agent.sh", "check", "--quick"],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Check: one test",
			"type": "process",
			"command": "godot",
			"args": ["--headless", "--path", "${workspaceFolder}", "-s", "tests/${input:test}.gd"],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Autotest (headless)",
			"type": "process",
			"command": "godot",
			"args": ["--headless", "--path", "${workspaceFolder}", "--", "--autotest"],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Import assets (after adding assets or a class_name)",
			"type": "process",
			"command": "godot",
			"args": ["--headless", "--import", "--path", "${workspaceFolder}"],
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "test",
			"type": "pickString",
			"description": "Which check",
			"options": ["void_arm_check", "guide_check", "training_check", "prompt_follow_check", "move_list_check",
				"comic_check", "hitstop_check", "camera_feel_check", "impact_frame_check", "trail_check", "enemy_feel_check",
				"heretic_shots"]
		}
	]
}
